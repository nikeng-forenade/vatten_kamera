{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Tester",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"pytest",
				"tests",
				"-q",
				"--no-header"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Kalibrera",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"calibrate",
				"--save"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Titta",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"peek",
				"--scale",
				"2"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Städa bort kalibrering",
			"type": "shell",
			"command": "Remove-Item",
			"args": [
				"-Force",
				"F:\\vscode\\vatten_kamera\\calibration.json"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Git: init och add",
			"type": "shell",
			"command": "git init -b main; git add -A; git status --short",
			"args": [],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Git: commit",
			"type": "shell",
			"command": "git -c user.name='nikeng-forenade' -c user.email='nikeng-forenade@users.noreply.github.com' commit -F captures/commit_msg.txt; git log --oneline -1",
			"args": [],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "GitHub: skapa och pusha",
			"type": "shell",
			"command": "gh repo create nikeng-forenade/vatten_kamera --private --source . --remote origin --push",
			"args": [],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Titta",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"peek",
				"--scale",
				"2"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "ISAPI-probe",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"tools\\isapi_probe.py"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Bildinställningar: visa",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"image",
				"show"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Bildinställningar: exponering",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"image",
				"set",
				"overexpose_suppress=true",
				"gain=25",
				"shutter=1/120"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Bildinställningar: dagsläge",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"image",
				"set",
				"ircut=day"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Exponering: optimera",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"image",
				"tune"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Exponering optimera",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"image",
				"tune"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Läs nu",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"main.py",
				"read",
				"--seconds",
				"15",
				"--spara"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Ta bort gammalt commit-msg",
			"type": "shell",
			"command": "Remove-Item -Force F:\\vscode\\vatten_kamera\\captures\\commit_msg.txt; Write-Output raderad",
			"args": [],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Git: commit och push",
			"type": "shell",
			"command": "git add -A; git -c user.name='nikeng-forenade' -c user.email='nikeng-forenade@users.noreply.github.com' commit -F captures/commit_msg.txt; git push; git log --oneline -2",
			"args": [],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Git: ta bort kalibrering ur repot",
			"type": "shell",
			"command": "git rm --cached calibration.json; Remove-Item -Force calibration.json -ErrorAction SilentlyContinue; git add -A; git -c user.name='nikeng-forenade' -c user.email='nikeng-forenade@users.noreply.github.com' commit -m 'Kalibreringen ar platsspecifik och ska inte versionshanteras'; git push",
			"args": [],
			"problemMatcher": [],
			"group": "build"
		}
	]
}