# Kopiera till .env och fyll i riktiga värden. .env är gitignorerad.

# --- Kamera (Hikvision/ONVIF, källaren) ---
CAMERA_IP=192.168.1.213
CAMERA_USER=admin
CAMERA_PASSWORD=bytt-mig
CAMERA_RTSP_PORT=554
CAMERA_HTTP_PORT=80
CAMERA_CHANNEL=101
# RTSP-väg enligt ONVIF-konfig: /Streaming/Channels/1?transportmode=unicast&profile=Profile_1
CAMERA_RTSP_PATH=/Streaming/Channels/1?transportmode=unicast&profile=Profile_1
CAMERA_SUBSTREAM_PATH=/Streaming/Channels/2?transportmode=unicast&profile=Profile_2

# --- Displayen ---
# Utsnittet (x1,y1,x2,y2) dar siffrorna sitter. Justeras med "main.py peek"
# och sparas med "main.py calibrate --save".
CALIBRATION_ROI=
# Antal siffror pa displayen.
DIGIT_COUNT=4
# Antal decimaler i vardet. Visar displayen 1.22 och 0.50 ar det 3 siffror och
# 2 decimaler.
DECIMALS=2
# Kraver att alla siffror lyser. Visar displayen alltid ledande nolla (0.50)
# betyder en slackt siffra att tolkningen hamnat fel.
REQUIRE_ALL_DIGITS=true
# Enhet vid sensorn i HA (t.ex. m3 eller l). Tom = ingen enhet.
UNIT=
# Andel av utsnittets hojd som klipps bort nedtill (den spegelvanda
# reflektionen i displayglaset). 0 = klipp inget.
CLIP_BOTTOM=0.0
# Vilken fargkanal som blir graaskala: auto, gray, r, g eller b. En rod LED
# lyser i rodkanalen men gloden runt siffrorna gors ocksa av rodt ljus - i
# bla kanalen lyser siffrorna medan gloden blir svart.
COLOR_CHANNEL=auto
# Fast troskel 0-255. 0 = Otsu (automatisk). Hog troskel hjalper nar siffrorna
# ar mattade och det finns svagare ljus runt dem, som en spegelbild i glaset.
THRESHOLD=0
# Forstoring innan troskling - sma siffror behover mer pixlar.
UPSCALE=5

# --- Nar vi laser ---
# Klockslaget da vardet visas.
RUN_AT=02:00:00
# Hur lange vi laser.
WINDOW_S=25
# Tid mellan bilderna.
INTERVAL_S=1.0
# Hur langt innan klockslaget korningen startar (lampan ska hinna tandas).
PRE_START_S=8
# Vanta sa har lange efter att lampan tands innan forsta bilden.
LAMP_WARMUP_S=2.0
# Antal bilder som maste vara eniga for att vardet ska publiceras.
MIN_AGREEMENT=3
# Minsta konfidens per siffra (0-1).
MIN_CONFIDENCE=0.75
# Spara bilderna fran varje korning.
SAVE_FRAMES=true
# Lana kameran till lasprofilen (camera_profile.json) under sjalva lasningen och
# lagg tillbaka kamerans eget lage direkt efter. Stang av med false.
USE_CAMERA_PROFILE=true
# Skicka notis till HA om lasningen misslyckas.
NOTIFY_ON_FAILURE=false

# --- Home Assistant ---
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=bytt-mig
# Lampan vid pumpen (light.* eller switch.*). Tom = ingen lampstyrning.
HA_LIGHT_ENTITY=

# --- MQTT (sensorn dyker upp i HA via discovery) ---
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=vatten_kamera
MQTT_ENABLED=true
