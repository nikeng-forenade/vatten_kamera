# Credentials & lokal konfiguration
.env
*.local.json

# Filen som tools/settings_file.py skriver innehaller kamerans adress.
settings_export.json

# Kalibreringen ar specifik for kamerans exakta placering och gors pa plats
# med "main.py calibrate --save". Den ska inte folja med till en annan maskin.
calibration.json

# Kamerans egna installningar och den lasprofil som anvands vid lasning.
# Bada ar lokala for just den har kameran.
camera_settings_backup.json
camera_profile.json

# Fångade bilder / debug
captures/
debug_frames/
*.jpg
*.png
!docs/**/*.png
# Brand-ikonen hor till integrationen och ska med (gors om med tools/make_icon.py).
!custom_components/*/brand/*.png

# Senaste lasningen, historiken och loggen - skrivs av tjansten, inte kod.
latest.json
latest.json.tmp
history.jsonl
history.jsonl.tmp
*.log

# Pythonskrräp
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
